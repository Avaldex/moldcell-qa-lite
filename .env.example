# Copy to ".env" and edit. ".env" is git-ignored.

# Appium 2.x server (started with the `appium` command)
APPIUM_URL=http://127.0.0.1:4723

# Device name from `adb devices` (the one with status "device")
UDID=emulator-5554

APP_PACKAGE=md.moldcell.selfservice
# APP_ACTIVITY=   (optional; Appium usually detects it)

# Negative login test: a NON-EXISTENT account (never use a real subscriber number or e-mail)
FAKE_USERNAME=nonexistent.user@example.com
FAKE_PASSWORD=WrongPass123!

# Optional authorized test only (pytest -m authorized). Use a DISPOSABLE test account.
# LOGIN_USERNAME=
# LOGIN_PASSWORD=
